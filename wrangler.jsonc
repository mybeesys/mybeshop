{
  "name": "mybeshop",
  // SPA + Flutter web.
  // Cloudflare Workers Builds IGNORES build.command below — set in Dashboard → Settings → Builds:
  //   Option A: Build command = npm run build  |  Deploy command = npx wrangler deploy
  //   Option B: Build command = (empty)        |  Deploy command = npm run cf:deploy
  "compatibility_date": "2025-05-25",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
