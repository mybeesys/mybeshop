{
  "name": "mybeshop",
  // SPA + Flutter web. Wrangler runs `npm run build` before deploy (see `build.command`).
  // Cloudflare Workers Builds can use deploy command: npx wrangler deploy
  // First CI build may take 5–10 min (Flutter SDK install).
  "compatibility_date": "2025-05-25",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
